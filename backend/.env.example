# ==============================================================================
# Northstar Vulnerability Management Platform - Backend Configuration
# ==============================================================================

# Server Settings
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Security & CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=super-secret-jwt-key-replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Persistence
# Default fallback: SQLite in local directory
DATABASE_URL=sqlite:///./vuln_scanner.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/vulnscanner

# Concurrency & Scanner Safeguards
MAX_CONCURRENT_SCANS=3
QUICK_SCAN_TIMEOUT_SEC=180
FULL_SCAN_TIMEOUT_SEC=600

# Security Intelligence Feeds
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
CISA_KEV_CACHE_TTL_HOURS=24

# Alerting & Webhooks (Optional)
ALERT_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENTS=

